# ── サーバー設定 ───────────────────────────────
PORT=3000

# ── X (Twitter) 公式 API ───────────────────────
# X API v2 の Bearer Token。未設定の場合はモックデータで動作します。
# 取得: https://developer.x.com/ （App の Bearer Token）
X_BEARER_TOKEN=

# ── Anthropic (Claude) API ─────────────────────
# AI 判定・DM 生成に使用。未設定の場合はルールベースの簡易判定にフォールバックします。
ANTHROPIC_API_KEY=

# 使用するモデル（省略時は claude-opus-5）
AI_MODEL=claude-opus-5
