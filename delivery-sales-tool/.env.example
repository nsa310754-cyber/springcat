# ── サーバー設定 ───────────────────────────────
PORT=3000

# ── X (Twitter) 公式 API ───────────────────────
# X API v2 の Bearer Token。未設定の場合はモックデータで動作します。
# 取得: https://developer.x.com/ （App の Bearer Token）
X_BEARER_TOKEN=

# ── AI プロバイダの選択 ─────────────────────────
# anthropic / gemini / (空=キーの有無から自動判定)
# どちらのキーも無い場合はルールベースの簡易判定にフォールバックします。
AI_PROVIDER=

# ── Anthropic (Claude) ─────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── Google (Gemini) ────────────────────────────
# Gemini API キー（Google Cloud Console / AI Studio で発行）
GEMINI_API_KEY=
# 使用モデル（省略時は gemini-3.6-flash。例: gemini-flash-latest / gemini-3.6-flash）
GEMINI_MODEL=gemini-3.6-flash
