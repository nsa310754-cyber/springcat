# ── サーバー設定 ───────────────────────────────
PORT=3000

# ── X (Twitter) 公式 API ───────────────────────
# 未設定の場合はモックデータで動作します。取得: https://developer.x.com/
# 方法A: Bearer Token を直接指定
X_BEARER_TOKEN=
# 方法B: API Key / Secret（consumer key/secret）を指定すると
#        アプリ側で自動的に Bearer Token を生成します（AでもBでも可）
X_API_KEY=
X_API_SECRET=
# ※ X APIは2026年2月から従量課金(pay-per-use)制。検索(tweets/search/recent)は
#   投稿読み取り 約$0.005/件。X Developer Portalでクレジットをチャージすれば使えます。
#   残高0だと 402(credits depleted) になり、その場合は自動でモックにフォールバックします。

# ── AI プロバイダの選択 ─────────────────────────
# anthropic / gemini / (空=キーの有無から自動判定)
# どちらのキーも無い場合はルールベースの簡易判定にフォールバックします。
AI_PROVIDER=

# ── Anthropic (Claude) ─────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── Google (Gemini) ────────────────────────────
# Gemini API キー（Google Cloud Console / AI Studio で発行）
GEMINI_API_KEY=
# 使用モデル（省略時は gemini-3.6-flash。例: gemini-flash-latest / gemini-3.6-flash）
GEMINI_MODEL=gemini-3.6-flash
