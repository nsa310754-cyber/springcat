<?xml version="1.0" encoding="utf-8"?>
<!-- Device Admin ポリシー宣言。
     非推奨ポリシー(disable-camera / limit-password 等)は Android 10+ で機能しないため
     実際に有効な範囲のみ最小限で宣言する。 -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <wipe-data />
        <watch-login />
    </uses-policies>
</device-admin>
