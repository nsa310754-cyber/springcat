<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 実行したプログラムが通信できるように (制限モードではアプリの権限がそのまま使われる) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- root が無いときに標準のインストーラへ APK を渡すため -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 制限モードのシェルから /sdcard を読み書きするため -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- スタートメニューに端末のアプリ一覧を出すため (Android 11 以降はこの宣言が無いと見えない) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- root 管理アプリが入っているかを調べ、許可の仕方を案内するため -->
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!-- パソコン風のデスクトップ。HOME カテゴリを持つので端末のホームアプリに選べる -->
        <activity
            android:name=".DesktopActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/DesktopTheme"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ターミナル。デスクトップとは別タスクにして、ホームへ戻ってもシェルが終了しないようにする -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:label="@string/terminal_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize">
            <!-- ファイルマネージャ等の「アプリで開く」から APK / 実行ファイルを受け取る -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-executable" />
                <data android:mimeType="application/x-pie-executable" />
                <data android:mimeType="application/x-elf" />
                <data android:mimeType="application/x-sh" />
            </intent-filter>
        </activity>

        <!-- 絵や音を出すプログラムの画面。ターミナルと同じタスクに重ね、閉じるとターミナルへ戻る -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density|navigation"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- root 権限のエクスプローラー。ターミナルとは別のタスクで開く -->
        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:label="@string/files_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.files"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 設定 (システム情報・タスクマネージャー・プログラムの追加と削除・個人設定) -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:label="@string/settings_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.settings" />
    </application>
</manifest>
