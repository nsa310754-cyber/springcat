<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 実行したプログラムが通信できるように (制限モードではアプリの権限がそのまま使われる) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- root が無いときに標準のインストーラへ APK を渡すため -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 制限モードのシェルから /sdcard を読み書きするため -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 実行したプログラムが画面の上に表示を出すため (br overlay)。利用者が設定で許可したときだけ使える -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 表示や自動操作のプログラムを、ほかのアプリを前面にしても動かし続けるための常駐 (通知を出す) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- リアルタイム保護を、端末の起動時に自動で始めるため (オンにしているときだけ) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wi-Fi の接続速度を返すため (br net) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- root が無いときのアプリの終了 (裏で動いている分だけ) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- スタートメニューに端末のアプリ一覧を出すため (Android 11 以降はこの宣言が無いと見えない) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- root 管理アプリが入っているかを調べ、許可の仕方を案内するため -->
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="me.bmax.apatch" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <!-- パソコン風のデスクトップ。HOME カテゴリを持つので端末のホームアプリに選べる -->
        <activity
            android:name=".DesktopActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/DesktopTheme"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 専用キーボード (Android の入力方法)。Esc・F1〜F12・Ctrl・Alt・矢印などを備える -->
        <service
            android:name=".BrKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <!-- 専用キーボードの設定 (Android の設定のキーボードの画面からも開かれる) -->
        <activity
            android:name=".KeyboardSettingsActivity"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:taskAffinity="site.springcat.bionicrunner.keyboard" />

        <!-- Chrome の「ホーム画面に追加」などで、アプリがホーム画面にショートカットを置くときの確認 -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="site.springcat.bionicrunner.pin"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- ターミナル。デスクトップとは別タスクにして、ホームへ戻ってもシェルが終了しないようにする -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:label="@string/terminal_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize">
            <!-- ファイルマネージャ等の「アプリで開く」から APK / 実行ファイル / 圧縮ファイルを受け取る -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-executable" />
                <data android:mimeType="application/x-pie-executable" />
                <data android:mimeType="application/x-elf" />
                <data android:mimeType="application/x-sh" />
                <!-- 圧縮ファイル: 展開して中の実行ファイルを登録する -->
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/x-gtar" />
                <data android:mimeType="application/x-compressed-tar" />
                <data android:mimeType="application/x-xz" />
                <data android:mimeType="application/x-bzip2" />
                <data android:mimeType="application/zip" />
                <!-- YARA ルール (.yar)。決まった種類名が無く、テキストとして渡されることが多い -->
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-yara" />
            </intent-filter>
        </activity>

        <!-- 絵や音を出すプログラムの画面。ターミナルと同じタスクに重ね、閉じるとターミナルへ戻る -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density|navigation"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- root 権限のエクスプローラー。ターミナルとは別のタスクで開く -->
        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:label="@string/files_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.files"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ゲームモード: HTML / JavaScript / TypeScript をブラウザ部品で動かす画面 -->
        <activity
            android:name=".WebGameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ゲームモード: Go / Python / Lua / シェルスクリプトを文字端末の画面で動かす -->
        <activity
            android:name=".TermGameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:taskAffinity="site.springcat.bionicrunner.terminal"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 画面の上への表示や自動操作のプログラムが動いているあいだ、アプリを生かしておく常駐 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="利用者が実行したプログラムの画面上の表示と自動操作を継続するため" />
        </service>

        <!-- セキュリティのリアルタイム保護 (ファイルが置かれたらすぐ検査する常駐) -->
        <service
            android:name=".RealtimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="利用者がオンにしたウイルス対策のリアルタイム保護 (新しいファイルの検査) のため" />
        </service>
        <receiver
            android:name=".RealtimeService$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- セキュリティ (保護の状態・スキャン・定義の更新・隔離) -->
        <activity
            android:name=".SecurityActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:taskAffinity="site.springcat.bionicrunner.security" />

        <!-- 自動操作 (br ui / tap) 用のユーザー補助。利用者が Android の設定で有効にしたときだけ動く -->
        <service
            android:name=".BrAccessibilityService"
            android:exported="true"
            android:label="Bionic Runner 自動操作"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/br_accessibility" />
        </service>

        <!-- セキュリティ研究用の仮想マシン (準備と起動の画面) -->
        <activity
            android:name=".VmActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:taskAffinity="site.springcat.bionicrunner.vm" />

        <!-- Windows 11 (ARM64) の仮想マシン (KVM・root。試験中): 準備と起動の画面、Windows の画面 -->
        <activity
            android:name=".WinVmActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:taskAffinity="site.springcat.bionicrunner.vm" />
        <activity
            android:name=".WinVmScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="site.springcat.bionicrunner.winvm" />

        <!-- X11 (Xサーバー): アプリの中の Linux 環境で動かす X の画面 -->
        <activity
            android:name=".X11Activity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:taskAffinity="site.springcat.bionicrunner.x11" />

        <!-- Linux の追加機能 (選んでダウンロードして入れる) -->
        <activity
            android:name=".LinuxAddonsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:taskAffinity="site.springcat.bionicrunner.x11" />

        <!-- zip.exe: 最初から入っている圧縮・解凍アプリ (パスワード付き zip に対応) -->
        <activity
            android:name=".ZipActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:label="@string/zip_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.zip"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 設定 (システム情報・タスクマネージャー・プログラムの追加と削除・個人設定) -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:label="@string/settings_name"
            android:launchMode="singleTask"
            android:taskAffinity="site.springcat.bionicrunner.settings" />
    </application>
</manifest>
